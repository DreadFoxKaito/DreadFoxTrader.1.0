# Cryptid Exchange clone-safe environment template.
# Copy to .env only for machine-local settings. Do not commit real secrets.

# Server TLS is optional. Leave blank for HTTP.
# If CERT_FILE/KEY_FILE are set but the files do not exist on this machine,
# the app automatically falls back to HTTP.
CERT_FILE=
KEY_FILE=

# Robinhood does not require .env keys. Link it from /broker using robin_stocks credentials/session.

# Required for encrypted local broker secret storage.
# setup_new_user.py will generate this automatically in .env.
APP_SECRET_KEY=

# Schwab is optional. Leave these blank for Robinhood-only installs.
# Prefer configuring Schwab from /broker. Environment values, when set, override broker-page settings.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://127.0.0.1:8000/callback
SCHWAB_SCOPE=readonly
SCHWAB_TRADER_API_BASE=https://api.schwabapi.com/trader/v1
SCHWAB_MARKET_DATA_BASE=
SCHWAB_ACCOUNT_HASH=

# Legacy compatibility: set to 1 only if you want app/data/schwab_token.json auto-imported into broker_connections.
CRYPTID_IMPORT_LEGACY_SCHWAB_TOKEN=0

# Server launch safety. Development defaults are one worker and reload disabled.
CRYPTID_SERVER_WORKERS=1
CRYPTID_SERVER_RELOAD=0

# Run-supervision safety. Auto-restart applies only to runs launched by the current server process.
CRYPTID_AUTO_RESTART_RUNS=1
CRYPTID_RUN_MAX_AUTO_RESTARTS=3
CRYPTID_STOP_RUNS_ON_SHUTDOWN=1

# Optional: set to a small positive integer to limit NumPy/OpenBLAS/MKL/NumExpr threads in algorithm subprocesses.
CRYPTID_ALGO_NUM_THREADS=

# Assistant monitors are optional.
ASSISTANT_MONITORS_ENABLED=0

# Assistant news workflow uses your OpenAI Platform account through a server-side API key.
# Create an API key at https://platform.openai.com/api-keys, put it only in .env,
# and restart the server. The key is never sent to browser JavaScript.
ASSISTANT_MODEL_RUNS_ENABLED=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_MODEL_CHOICES=
ASSISTANT_NEWS_OPENAI_TIMEOUT=180
ASSISTANT_NEWS_MAX_INPUT_CHARS=180000
ASSISTANT_NEWS_MAX_OUTPUT_TOKENS=6000
